# Nginx Proxy Manager Data Directory Configuration
# Copy this file to .env and modify the values for your environment

# Path to Nginx Proxy Manager data directory
# Default: /apps/nginxproxymanager/data
# Common locations:
#   - /apps/nginxproxymanager/data (npm docker compose)
#   - /opt/nginxproxymanager/data
#   - /var/lib/nginxproxymanager/data
#   - /usr/share/nginxproxymanager/data
NPM_DATA_DIR=/apps/nginxproxymanager/data